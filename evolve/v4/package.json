    "critical-rates": "cd ../.. && deno run -A evolve/v4/tools/critical_rates.ts",
    "typecheck": "tsc -p tsconfig.json",
    "spans": "python3 tools/make_spans.py"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "ajv": "^8.17.1"
  }
}
