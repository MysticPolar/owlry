{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Owlry Blind Comparison Judge 4.2 output",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "blind-4.2.0"
    },
    "winner": {
      "type": "string",
      "enum": [
        "A",
        "B",
        "tie"
      ]
    },
    "margin": {
      "type": "string",
      "enum": [
        "clear",
        "small_but_meaningful",
        "none"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "comparisons": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "aspect": {
            "type": "string",
            "minLength": 1
          },
          "a_location": {
            "type": "string",
            "minLength": 1
          },
          "a_observation": {
            "type": "string",
            "minLength": 1
          },
          "b_location": {
            "type": "string",
            "minLength": 1
          },
          "b_observation": {
            "type": "string",
            "minLength": 1
          },
          "advantage": {
            "type": "string",
            "enum": [
              "A",
              "B",
              "tie"
            ]
          },
          "why_it_matters": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "aspect",
          "a_location",
          "a_observation",
          "b_location",
          "b_observation",
          "advantage",
          "why_it_matters"
        ]
      },
      "minItems": 1,
      "maxItems": 3
    },
    "best_of_a": {
      "type": "string",
      "minLength": 1
    },
    "best_of_b": {
      "type": "string",
      "minLength": 1
    },
    "concerns": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "side": {
            "type": "string",
            "enum": [
              "A",
              "B",
              "both"
            ]
          },
          "type": {
            "type": "string",
            "enum": [
              "grounding",
              "safety",
              "format",
              "uncertainty"
            ]
          },
          "severity": {
            "type": "string",
            "enum": [
              "minor",
              "material",
              "critical"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "observed",
              "suspected",
              "unverified",
              "supported_by_evidence"
            ]
          },
          "location": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          }
        },
        "required": [
          "side",
          "type",
          "severity",
          "status",
          "location",
          "description",
          "evidence_ids"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "supported_by_evidence"
                }
              }
            },
            "then": {
              "properties": {
                "evidence_ids": {
                  "minItems": 1
                }
              }
            }
          }
        ]
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "winner",
    "margin",
    "reason",
    "comparisons",
    "best_of_a",
    "best_of_b",
    "concerns"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "winner": {
            "const": "tie"
          }
        }
      },
      "then": {
        "properties": {
          "margin": {
            "const": "none"
          }
        }
      },
      "else": {
        "properties": {
          "margin": {
            "enum": [
              "clear",
              "small_but_meaningful"
            ]
          }
        }
      }
    }
  ]
}