# Owlry — client env (copy to .env.local, never commit real values)
#
# Leave BOTH unset to run fully offline: no login wall, no history, no
# memory UI, the simulated brain answers every ask — exactly like the
# mockup. Set both to turn on the live owl (Scout + Peek), invite-gated
# login, chat history, and the memory view/edit page.

# Supabase project URL and anon (publishable) key — safe to expose to the
# browser; every table the app touches is protected by Row Level Security.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
