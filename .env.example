# owlry — Walk with Great Minds
#
# The front-end prototype on this branch reads no environment variables: the
# council is simulated on the client and state lives in localStorage.
#
# When the backend phase wires Supabase back in, the public client keys go
# here (both are safe to ship; access is governed by RLS):
#
# VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# VITE_SUPABASE_ANON_KEY=<anon key>
