# Owlry web app — environment.
# Copy to `.env.local` and fill in. With these UNSET, the app runs entirely
# local (IndexedDB) exactly as it does today; setting them lights up the
# Supabase backend (XP / ink / coins / calendar / radar served from the server).
#
# The anon key is a PUBLIC key — safe to ship to the browser; Row-Level
# Security is what actually protects the data.

VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# ── the live owl chat ──────────────────────────────────────────────
# The owl's brain runs in the `owl-chat` Supabase edge function, which
# calls the Anthropic API. The key is a SERVER-SIDE Supabase secret —
# it is NEVER shipped to the browser. Set it with:
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
# and deploy:
#   supabase functions deploy owl-chat
#
# With a backend configured, the live owl answers by default. To force
# the offline mockup brain everywhere (e.g. for demos), set:
# VITE_OWL_LIVE=off
#
# (Users can also flip live ⇄ classic any time in Settings → THE OWL.)
